{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@dynsnap/src/*": ["src/*"],
      "@/*": ["../../Bilibili-Evolved/src/*"]
    }
  },
  "include": ["src"]
}
