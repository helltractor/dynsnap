{
  "manifest_version": 3,
  "name": "动态截图（dynshot）",
  "version": "0.0.1",
  "description": "通用 DOM 卡片截图扩展：SnapDOM 元素级捕获，站点适配器驱动；opus 详情页自动跳转 t.bilibili.com 旧版动态页截图，规避新版布局变动。",
  "host_permissions": [
    "https://t.bilibili.com/*",
    "https://www.bilibili.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://t.bilibili.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "snapdom.js",
        "sites.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
